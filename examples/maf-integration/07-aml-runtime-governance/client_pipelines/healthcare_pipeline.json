{
  "format": "client-pipeline-definition/v1",
  "description": "Healthcare company pipeline definition: declared care agents, topology, permissions, and governance policies. Live patient cases are attached only at runtime.",
  "system": {
    "name": "healthcare-care-path",
    "schema": "healthcare-care-path/v1",
    "agents": [
      {"id": "patient-intake", "node_id": "H-A", "role": "Routes the submitted patient care request"},
      {"id": "allergy-safety", "node_id": "H-B", "role": "Checks medication safety against allergy records"},
      {"id": "medication-review", "node_id": "H-C", "role": "Validates the medication order"},
      {"id": "coverage-review", "node_id": "H-D", "role": "Checks payer authorization status"},
      {"id": "care-decision", "node_id": "H-E", "role": "Merges clinical and coverage findings into a care decision"}
    ],
    "topology": {
      "patient-intake": [],
      "allergy-safety": ["patient-intake"],
      "medication-review": ["patient-intake"],
      "coverage-review": ["patient-intake"],
      "care-decision": ["allergy-safety", "medication-review", "coverage-review"]
    },
    "permissions": {
      "patient-intake": ["route_care_request"],
      "allergy-safety": ["evaluate_allergy_safety"],
      "medication-review": ["validate_medication_order"],
      "coverage-review": ["verify_coverage"],
      "care-decision": ["merge_care_decision"]
    },
    "final_agent": "care-decision",
    "final_action": "commit_care_decision",
    "resolver_action": "resolve_care_correctness",
    "handoff_action": "healthcare_handoff",
    "resource_prefix": "healthcare-case",
    "escalation_outcomes": ["HOLD_FOR_CLINICAL_REVIEW", "HOLD_FOR_AUTHORIZATION"]
  },
  "policy": {
    "graph": {
      "apiVersion": "governance.toolkit/v1",
      "version": "1.0",
      "name": "healthcare-graph-governance",
      "description": "Authorize declared healthcare handoffs and delegate trace/correctness evaluation to the resolver.",
      "agents": ["*"],
      "scope": "global",
      "default_action": "allow",
      "rules": [
        {
          "name": "allow-authorized-handoff",
          "stage": "pre_tool",
          "condition": "handoff.status == 'authorized'",
          "action": "allow",
          "priority": 100
        },
        {
          "name": "deny-unauthorized-handoff",
          "stage": "pre_tool",
          "condition": "handoff.status != 'authorized'",
          "action": "deny",
          "priority": 100
        },
        {
          "name": "deny-commit-without-graph",
          "stage": "post_tool",
          "condition": "governance_graph.schema != 'healthcare-care-path/v1'",
          "action": "deny",
          "priority": 100
        }
      ]
    },
    "action": {
      "apiVersion": "governance.toolkit/v1",
      "version": "1.0",
      "name": "healthcare-action-governance",
      "description": "Combine healthcare authorization, trace integrity, content, and optional correctness signals.",
      "agents": ["*"],
      "scope": "global",
      "default_action": "deny",
      "rules": [
        {
          "name": "deny-unauthorized-action",
          "stage": "post_tool",
          "condition": "action.status == 'unauthorized'",
          "action": "deny",
          "priority": 200
        },
        {
          "name": "require-review-for-unreconciled-conflict",
          "stage": "post_tool",
          "condition": "governance.status == 'conflict'",
          "action": "require_approval",
          "priority": 180
        },
        {
          "name": "deny-incorrect-behavioral-result",
          "stage": "post_tool",
          "condition": "governance.status == 'failed'",
          "action": "deny",
          "priority": 150
        },
        {
          "name": "require-review-for-nemo-flag",
          "stage": "post_tool",
          "condition": "nemo.status == 'flagged'",
          "action": "require_approval",
          "priority": 100
        },
        {
          "name": "allow-clean-action",
          "stage": "post_tool",
          "condition": "action.status == 'authorized' and governance.status == 'passed' and nemo.status == 'passed'",
          "action": "allow",
          "priority": 50
        },
        {
          "name": "allow-with-nemo-unavailable",
          "stage": "post_tool",
          "condition": "action.status == 'authorized' and governance.status == 'passed' and nemo.status == 'unavailable'",
          "action": "allow",
          "priority": 40
        }
      ]
    }
  },
  "harness": {
    "version": 1,
    "description": "Governance harness for the healthcare care path: how to instrument the existing LangGraph pipeline's real-LLM care-decision agent and size its context window. Values are taken from the pipeline code and the local Ollama runtime.",
    "framework": "langgraph",
    "model": {
      "name": "llama3.1:8b",
      "provider": "ollama",
      "base_url": "http://localhost:11434",
      "tokenizer": {
        "source": "ollama-gguf",
        "model": "llama3.1:8b",
        "type": "gpt2",
        "pre": "llama-bpe",
        "add_bos": true
      },
      "window_param": "num_ctx",
      "current_window": 1024,
      "advertised_window": 131072
    },
    "context_assembly": {
      "chat_template": {
        "name": "ollama-llama3.1",
        "engine": "jinja2",
        "runtime_template_sha256": "948af2743fc78a328dcb3b0f5a31b3d75f415840fdb699e8b1235978392ecf85",
        "template": "{%- set system = messages | selectattr('role', 'equalto', 'system') | map(attribute='content') | join('\\n') -%}{%- if tools -%}{{ unsupported('tools') }}{%- endif -%}{%- if system -%}<|start_header_id|>system<|end_header_id|>\n\n{{ system }}<|eot_id|>{%- endif -%}{%- for m in messages if m.role != 'system' -%}{%- if m.role == 'user' -%}<|start_header_id|>user<|end_header_id|>\n\n{{ m.content }}<|eot_id|>{%- if loop.last %}<|start_header_id|>assistant<|end_header_id|>\n\n{% endif -%}{%- elif m.role == 'assistant' -%}<|start_header_id|>assistant<|end_header_id|>\n\n{{ m.content }}{%- if not loop.last %}<|eot_id|>{% endif -%}{%- else -%}{{ unsupported(m.role) }}{%- endif -%}{%- endfor -%}"
      },
      "includes": {
        "care-decision": {
          "system_instructions": false,
          "task_instructions": "in the user message, after the reports",
          "tool_definitions": false,
          "upstream_findings": [
            "allergy-safety",
            "medication-review",
            "coverage-review"
          ],
          "case_activity_log": true,
          "history": true
        }
      },
      "calibration": {
        "window": 8192,
        "messages": [
          {
            "role": "user",
            "content": "Calibration: count these tokens exactly. Café 12345 naïve — 3.14."
          }
        ]
      }
    },
    "observability": {
      "can_capture_model_visible_prompt": false,
      "exposes_processed_token_count": true,
      "processed_token_field": "prompt_eval_count",
      "can_log_trimming": false,
      "truncation_policy": "keep_tail",
      "model_call": {
        "http_function": "httpx.post",
        "endpoint": "/api/chat",
        "primary_call": "first"
      },
      "overflow_error_markers": [
        "context length",
        "exceeds",
        "too long",
        "context window"
      ]
    },
    "run_entry_point": {
      "module": "instrumentation",
      "function": "run_case",
      "window_argument": "window"
    },
    "pipeline": {
      "module": "healthcare.langgraph_pipeline",
      "nodes": "NODES",
      "state_schema": "CarePathState",
      "graph_builder": "build_care_path_graph",
      "run_function": "run_care_path_graph",
      "run_arguments": {
        "decision_mode": "llm-context-loss"
      },
      "normalize": "_normalize",
      "model_config_factory": "healthcare.llm_decision_agent:default_config",
      "window_state_key": "llm_config",
      "window_config_field": "num_ctx",
      "accumulated_state_argument": "accumulated_state",
      "model_config_field": "model",
      "records_codecs": "healthcare.client_payload:HEALTHCARE_RECORD_CODECS",
      "run_id_field": "case_id"
    },
    "evidence_formats": {
      "upstream_finding": {
        "pattern": "^\\[REPORT (?P<id>[a-z0-9-]+) v(?P<version>\\d+)\\] [^:]+: (?P<finding>[A-Za-z0-9_-]+)\\.",
        "source": {
          "state_key": "steps",
          "finding_field": "finding",
          "version_field": "finding_version"
        }
      }
    },
    "agents": [
      {
        "name": "patient-intake",
        "required_evidence": [],
        "high_consequence_action": false,
        "keeps_history": false,
        "calls_model": false
      },
      {
        "name": "allergy-safety",
        "required_evidence": [],
        "high_consequence_action": false,
        "keeps_history": false,
        "calls_model": false
      },
      {
        "name": "medication-review",
        "required_evidence": [],
        "high_consequence_action": false,
        "keeps_history": false,
        "calls_model": false
      },
      {
        "name": "coverage-review",
        "required_evidence": [],
        "high_consequence_action": false,
        "keeps_history": false,
        "calls_model": false
      },
      {
        "name": "care-decision",
        "required_evidence": [
          "allergy-safety",
          "medication-review",
          "coverage-review"
        ],
        "evidence_format": "upstream_finding",
        "high_consequence_action": true,
        "keeps_history": true,
        "calls_model": true
      }
    ],
    "sizing": {
      "resolution": 16
    },
    "longrun_demo": {
      "description": "Side-by-side long-running demo: the same case and window, with little vs. a large synthesized accumulated history in the care-decision agent's context. Case 2 is an accelerated simulation.",
      "window": 4096,
      "early_tokens": 200,
      "aged_tokens": 2400,
      "cadence_days": 1,
      "start_date": "2026-01-01",
      "prompt_builder": "healthcare.llm_decision_agent:build_case_file",
      "degradation": {
        "description": "Degradation (lost in the middle): a large window so the buried finding always fits; the history grows by growth_factor until the model stops using the finding or max_aged_tokens is reached.",
        "window": 16384,
        "early_tokens": 200,
        "aged_tokens": 8000,
        "depth": 0.9,
        "growth_factor": 1.5,
        "max_aged_tokens": 28000,
        "max_window": 32768,
        "margin_tokens": 512
      }
    }
  }
}
